{
  "name": "hiep-dung-cms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "desktop/build/main.js",
  "scripts": {
    "dev": "vite",
    "dev:api": "prisma generate && tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "build": "prisma generate && tsc -b && tsc -p server && vite build",
    "test": "vitest run",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "desktop:dev": "npm run build && tsc -p desktop && electron .",
    "desktop:build": "npm run build && tsc -p desktop && electron-builder --win"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/pdfmake": "^0.2.13",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "docx": "^9.8.1",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^4.10.38",
    "pdfmake": "^0.2.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^16.6.1",
    "dotenv-expand": "^11.0.7",
    "embedded-postgres": "^18.6.0-beta.19",
    "express": "^4.22.3",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15"
  },
  "build": {
    "appId": "vn.hiepdung.cms",
    "productName": "Hiep Dung CMS",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "files": [
      "desktop/build/**",
      "dist/**",
      "server/**",
      "src/**",
      "prisma/**",
      "prisma.config.ts",
      "package.json",
      "!**/*.test.ts",
      "!node_modules/@electric-sql/**",
      "!node_modules/prisma/build/*{mysql,sqlite,sqlserver,cockroachdb}*",
      "!node_modules/@prisma/client/runtime/*{mysql,sqlite,sqlserver,cockroachdb}*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
