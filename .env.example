# ============================================================
#  Cấu hình CMS xưởng cơ khí Hiệp Dung — chép file này thành .env rồi sửa
# ============================================================

# ---------- Cổng (đổi nếu bị trùng với chương trình khác) ----------
# Cổng PostgreSQL mở ra máy thật (để Prisma / DBeaver / pgAdmin kết nối)
POSTGRES_PORT=5432
# Cổng máy chủ API (container "api"; cũng là cổng của "npm run dev:api")
API_PORT=3000
# Cổng giao diện khi chạy bằng Docker (container "web") — mở http://<IP máy>:WEB_PORT để dùng
WEB_PORT=5175
# Cổng giao diện khi phát triển bằng "npm run dev" (Vite chuyển tiếp /api sang API_PORT)
DEV_PORT=5174

# ---------- PostgreSQL ----------
POSTGRES_USER=hiepdung
POSTGRES_PASSWORD=doi_mat_khau_nay
POSTGRES_DB=hiep_dung_cms
# Host của DB khi chạy máy chủ API trực tiếp trên máy (npm run dev:api).
# Trong Docker, docker-compose tự đổi thành "db".
POSTGRES_HOST=localhost

# Prisma đọc biến này. Tự ghép từ các biến trên — thường không cần sửa.
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# ---------- Đăng nhập ----------
# Mỗi người một tài khoản (tạo trong màn "Tài khoản & quyền").
# Tài khoản Quản trị ĐẦU TIÊN do seed tạo khi DB chưa có tài khoản nào:
ADMIN_USERNAME=admin
# Để trống = seed tạo mật khẩu ngẫu nhiên và in ra màn hình (docker compose logs api). Đăng nhập rồi đổi ngay.
# Đổi biến này sau khi đã có tài khoản thì KHÔNG có tác dụng — đổi mật khẩu trong ứng dụng.
ADMIN_PASSWORD=
# Chuỗi bí mật để ký phiên đăng nhập. Đặt chuỗi ngẫu nhiên dài, ví dụ:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=doi_chuoi_bi_mat_nay

# ---------- Landing page ----------
# Tên miền của trang landing được gọi API công khai /api/cong-khai/* (CORS), cách nhau dấu phẩy.
# Để trống = cho phép mọi nơi. Ví dụ: https://cokhihiepdung.vn,https://www.cokhihiepdung.vn
LANDING_ORIGIN=

# ---------- Khác ----------
# true = lần đầu chạy (DB trống) tự nạp dữ liệu mẫu để xem thử
SEED_DU_LIEU_MAU=true
# Múi giờ (ảnh hưởng ngày lập chứng từ do máy chủ tạo)
TZ=Asia/Ho_Chi_Minh

# ---------- Lưu file ----------
# Thư mục lưu file PDF / Word / Excel khi bấm "Lưu" ở màn Xem trước (trên máy chạy ứng dụng).
# Đường dẫn tương đối tính từ thư mục dự án; có thể ghi đường dẫn đầy đủ, vd. D:/project/bao_gia_nhanh/file
THU_MUC_LUU_FILE=./file
