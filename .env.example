# ============================================================
#  Cấu hình khi PHÁT TRIỂN (npm run dev:api / npm run dev) — chép file này thành .env rồi sửa.
#  Bản desktop không dùng file này: tự sinh mật khẩu DB trong AppData.
# ============================================================

# ---------- Cổng (đổi nếu bị trùng với chương trình khác) ----------
# Cổng PostgreSQL mở ra máy thật (để Prisma / DBeaver / pgAdmin kết nối)
POSTGRES_PORT=5432
# Cổng máy chủ API khi chạy "npm run dev:api"
API_PORT=3000
# Cổng giao diện khi phát triển bằng "npm run dev" (Vite chuyển tiếp /api sang API_PORT)
DEV_PORT=5174

# ---------- PostgreSQL ----------
POSTGRES_USER=hiepdung
POSTGRES_PASSWORD=doi_mat_khau_nay
POSTGRES_DB=hiep_dung_cms
# Host của DB khi chạy máy chủ API trực tiếp trên máy (npm run dev:api)
POSTGRES_HOST=localhost

# Prisma đọc biến này. Tự ghép từ các biến trên — thường không cần sửa.
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# ---------- Khác ----------
# true = lần đầu chạy (DB trống) tự nạp dữ liệu mẫu để xem thử
SEED_DU_LIEU_MAU=true
# Múi giờ (ảnh hưởng ngày lập chứng từ do máy chủ tạo)
TZ=Asia/Ho_Chi_Minh

# ---------- Lưu file ----------
# Thư mục lưu file PDF / Word / Excel khi bấm "Lưu" ở màn Xem trước (trên máy chạy ứng dụng).
# Đường dẫn tương đối tính từ thư mục dự án; có thể ghi đường dẫn đầy đủ, vd. D:/project/bao_gia_nhanh/file
THU_MUC_LUU_FILE=./file
